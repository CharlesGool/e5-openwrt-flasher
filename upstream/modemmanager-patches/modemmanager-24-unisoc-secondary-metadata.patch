+
+/* Secondary IMSI/operator details are not a prerequisite for the data SIM.
+ * Keep CCID discovery synchronous (an unknown slot must not become absent),
+ * then complete these optional fields once the data bearer is connected.
+ * No timers, extra AT owner, SIM power changes or radio reordering. */
+static gboolean
+secondary_sim_is_current (MMBaseModem *self, MMBaseSim *sim)
+{
+    g_autoptr(GPtrArray) slots = NULL;
+    guint other = 1 - port_card ();
+
+    if (!mm_base_modem_get_valid (self))
+        return FALSE;
+    g_object_get (self, MM_IFACE_MODEM_SIM_SLOTS, &slots, NULL);
+    return slots && other < slots->len && g_ptr_array_index (slots, other) == sim;
+}
+
+static gchar *
+secondary_sim_parse_imsi (const gchar *response, const gchar *expected_iccid)
+{
+    g_auto(GStrv) lines = NULL;
+    g_autofree gchar *imsi = NULL;
+    gboolean matched = FALSE;
+    guint i;
+
+    if (!response || !expected_iccid || !*expected_iccid)
+        return NULL;
+    lines = g_strsplit_set (response, "\r\n", -1);
+    for (i = 0; lines[i]; i++) {
+        gchar *line = g_strstrip (lines[i]);
+        if (g_str_has_prefix (line, "+CCID:")) {
+            line = g_strstrip (line + strlen ("+CCID:"));
+            g_strdelimit (line, "\"", ' ');
+            line = g_strstrip (line);
+            if (matched || g_strcmp0 (line, expected_iccid))
+                return NULL;
+            matched = TRUE;
+        } else if (!g_strcmp0 (line, expected_iccid)) {
+            if (matched)
+                return NULL;
+            matched = TRUE;
+        } else if (*line && strspn (line, "0123456789") == strlen (line)) {
+            if (imsi || strlen (line) < 5)
+                return NULL;
+            imsi = g_strdup (line);
+        }
+    }
+    return matched ? g_steal_pointer (&imsi) : NULL;
+}
+
+static void
+secondary_sim_identity_ready (MMBaseModem *self, GAsyncResult *res, GTask *task)
+{
+    MMBaseSim *sim = g_task_get_task_data (task);
+    g_autoptr(GError) error = NULL;
+    g_autofree gchar *imsi = NULL;
+    g_autofree gchar *operator_id = NULL;
+    g_autofree gchar *restore = NULL;
+    const gchar *response;
+
+    response = mm_base_modem_at_command_finish (self, res, &error);
+    if (!error && secondary_sim_is_current (self, sim))
+        imsi = secondary_sim_parse_imsi (response, mm_gdbus_sim_get_sim_identifier (MM_GDBUS_SIM (sim)));
+    if (imsi) {
+        operator_id = g_strndup (imsi, 5);
+        mm_gdbus_sim_set_imsi (MM_GDBUS_SIM (sim), imsi);
+        mm_gdbus_sim_set_operator_identifier (MM_GDBUS_SIM (sim), operator_id);
+    } else
+        mm_obj_dbg (self, "secondary SIM identity remains unavailable; keeping slot presence");
+
+    /* Like the original slot loader, restore the selected command context.
+     * Never send restoration traffic through an invalidated modem. */
+    if (mm_base_modem_get_valid (self)) {
+        restore = g_strdup_printf ("+SPACTCARD=%u;+CFUN?", port_card ());
+        mm_base_modem_at_command (self, restore, 5, FALSE, NULL, NULL);
+    }
+    g_object_set_data (G_OBJECT (sim), "unisoc-identity-inflight", NULL);
+    g_object_unref (task);
+}
+
+static void
+secondary_sim_state_changed (MMBroadbandModemUnisoc *self, GParamSpec *pspec, gpointer unused)
+{
+    g_autoptr(GPtrArray) slots = NULL;
+    MMModemState state;
+    MMBaseSim *sim;
+    GTask *task;
+    const gchar *known_imsi;
+    g_autofree gchar *command = NULL;
+    guint other = 1 - port_card ();
+
+    (void) pspec;
+    (void) unused;
+    g_object_get (self, MM_IFACE_MODEM_STATE, &state,
+                  MM_IFACE_MODEM_SIM_SLOTS, &slots, NULL);
+    if (state != MM_MODEM_STATE_CONNECTED || !slots || other >= slots->len)
+        return;
+    sim = g_ptr_array_index (slots, other);
+    known_imsi = sim ? mm_gdbus_sim_get_imsi (MM_GDBUS_SIM (sim)) : NULL;
+    if (!sim || !secondary_sim_is_current (MM_BASE_MODEM (self), sim) ||
+        !mm_gdbus_sim_get_sim_identifier (MM_GDBUS_SIM (sim)) || (known_imsi && *known_imsi) ||
+        g_object_get_data (G_OBJECT (sim), "unisoc-identity-inflight"))
+        return;
+
+    /* Recheck CCID together with CIMI, so an insertion during this deferred
+     * operation cannot attach a replacement card's IMSI to an old SIM object. */
+    command = g_strdup_printf ("+SPACTCARD=%u;+CCID?;+CIMI", other);
+    g_object_set_data (G_OBJECT (sim), "unisoc-identity-inflight", GINT_TO_POINTER (1));
+    task = g_task_new (self, NULL, NULL, NULL);
+    g_task_set_task_data (task, g_object_ref (sim), g_object_unref);
+    mm_base_modem_at_command (MM_BASE_MODEM (self), command, 5, FALSE,
+                              (GAsyncReadyCallback) secondary_sim_identity_ready, task);
+}
+
