+/* SIPC is a fixed internal topology, not a USB composite device. Only end
+ * collection after the tagged AT port and the entire selected eight-context
+ * data bank have actually reached MM. Incomplete/external devices retain all
+ * generic waits. AT probing and every initialization command still run. */
+static gboolean
+device_context_has_complete_unisoc_ports (DeviceContext *ctx)
+{
+    GList *l;
+    gboolean tagged_at = FALSE;
+    guint bank;
+
+    for (l = mm_device_peek_port_probe_list (ctx->device); l; l = g_list_next (l)) {
+        MMKernelDevice *port = mm_port_probe_peek_port (MM_PORT_PROBE (l->data));
+
+        if (!g_strcmp0 (mm_kernel_device_get_subsystem (port), "wwan") &&
+            !g_strcmp0 (mm_kernel_device_get_driver (port), "sprd-spipe") &&
+            mm_kernel_device_get_property_as_boolean (port, "ID_MM_UNISOC_SIPC"))
+            tagged_at = TRUE;
+    }
+    if (!tagged_at)
+        return FALSE;
+
+    for (bank = 0; bank < 2; bank++) {
+        guint i;
+        for (i = 0; i < 8; i++) {
+            gchar name[16];
+            g_snprintf (name, sizeof (name), "sipa_eth%u", bank * 8 + i);
+            if (!mm_device_owns_port_name (ctx->device, "net", name))
+                break;
+        }
+        if (i == 8)
+            return TRUE;
+    }
+    return FALSE;
+}
