diff --git a/openwrt/build-hostapd-inner.sh b/openwrt/build-hostapd-inner.sh
old mode 100644
new mode 100755
index df65b5d..27f4761
--- a/openwrt/build-hostapd-inner.sh
+++ b/openwrt/build-hostapd-inner.sh
@@ -33,14 +33,33 @@ hostapd_make() {
     make CONFIG_DRIVER_11AC_SUPPORT=y CONFIG_DRIVER_11AX_SUPPORT=y \
         CONFIG_DRIVER_11BE_SUPPORT=y "$@"
 }
+# The SAE source change goes in as a patch of the package (patches/990-unisoc-sae.patch), which every
+# prepare applies: patching the unpacked tree is not enough -- the compile prepares it again (after
+# hostapd's dependencies are built) from the tarball, and wpad came out without unisoc_sae.
+SAE_PATCH=$H/patches/990-unisoc-sae.patch
+rm -f "$SAE_PATCH"
 hostapd_make "$H/clean"
 hostapd_make "$H/prepare" V=s
 source_dir=$(find build_dir/target-* -mindepth 2 -maxdepth 2 -type d -path '*/hostapd-wpad-basic-mbedtls/hostapd-*')
 [ -n "$source_dir" ] && [ "$(printf '%s\n' "$source_dir" | wc -l)" = 1 ] || {
     echo 'Unisoc WPA3: expected one prepared basic-mbedtls source' >&2; exit 1;
 }
-python3 /src/patch-hostapd-sae.py source "$source_dir"
+rm -rf /tmp/unisoc-sae && mkdir -p /tmp/unisoc-sae
+cp -a "$source_dir" /tmp/unisoc-sae/a && cp -a "$source_dir" /tmp/unisoc-sae/b
+python3 /src/patch-hostapd-sae.py source /tmp/unisoc-sae/b
+rc=0; (cd /tmp/unisoc-sae && diff -ruN -x '.*' a b) > "$SAE_PATCH" || rc=$?
+[ "$rc" = 1 ] && grep -q unisoc_sae "$SAE_PATCH" || { echo 'Unisoc WPA3: no source patch made' >&2; exit 1; }
+rm -rf /tmp/unisoc-sae
+hostapd_make "$H/clean"
 hostapd_make -j"$JOBS" "$H/compile" V=s
+# the daemon that was built has it: its source, and the config key in the binary
+grep -q '"unisoc_sae"' "$source_dir/hostapd/config_file.c" || {
+    echo 'Unisoc WPA3: the compiled source has no unisoc_sae' >&2; exit 1;
+}
+bin=$(find build_dir/target-*/hostapd-wpad-basic-mbedtls -path '*/ipkg-*/usr/sbin/wpad' -type f | head -n1)
+[ -n "$bin" ] && grep -aq unisoc_sae "$bin" || {
+    echo "Unisoc WPA3: the wpad binary does not know unisoc_sae (${bin:-no binary})" >&2; exit 1;
+}
 make "$W/clean"
 make -j"$JOBS" "$W/compile" V=s
 stage=$(mktemp -d /out/.wifi-sae.XXXXXX)
